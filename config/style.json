{
  "schema_version": 1,
  "profile": "portable-chat",
  "enabled": true,
  "mode": "observe",
  "maxMessagesPerHook": 20,
  "scopes": [],
  "reviseEnabled": false,
  "suppressEnabled": false,
  "suppressMaxChars": 12,
  "recent_window": 8,
  "expression_history": { "max_items": 50, "keep_days": 30, "cross_session": false },
  "prompt_preferences": {
    "grief_reply": "节哀",
    "punctuation": "闲聊优先逗号句号问号感叹号，技术内容和明确格式要求不受此偏好限制",
    "fixed_reply_length": null,
    "code_line_soft_limit": 10,
    "correction": "口吻反馈简短确认，事实反馈必须纠正事实",
    "mandatory_swearing": false
  },
  "collection": {
    "temperature": 0.8,
    "max_tokens": 1400,
    "timeout_seconds": 60,
    "workers": 4,
    "transient_retries": 2
  },
  "human_review": {
    "required_total": 100,
    "scores": ["自然度", "贴合度", "正确性"],
    "minimum_score": 3,
    "require_reviewer": true,
    "require_manual_attestation": true,
    "maximum_prompt_examples": 20
  }
}
